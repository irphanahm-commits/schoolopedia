# Schoolopedia Environment Configuration (Zero-Cost First)

# Environment
NODE_ENV=development
PORT=3000
API_PORT=8787

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787

# Cloudflare Infrastructure (Local / Staging / Production)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=schoolopedia-db
KV_NAMESPACE_ID=schoolopedia-cache
R2_BUCKET_NAME=schoolopedia-snapshots

# Authentication & Security
AUTH_SECRET=local-development-secret-key-replace-in-production-min-32-chars
JWT_SECRET=local-jwt-secret-key-replace-in-production-min-32-chars

# AI Integration (Strictly Optional - System runs deterministically if unset)
AI_PROVIDER=none
AI_API_KEY=

# YouTube API (Optional - System uses deterministic embed & fallback metadata)
YOUTUBE_API_KEY=
